# Cổng
# PORT=3000
# URL cơ sở của frontend
# FRONTEND_BASE_URL=https://your-frontend-url.com


# Cấu hình liên quan đến debug
# Bật pprof
# ENABLE_PPROF=true

# Cấu hình cơ sở dữ liệu
# Chuỗi kết nối cơ sở dữ liệu
# SQL_DSN=user:password@tcp(127.0.0.1:3306)/dbname?parseTime=true
# Chuỗi kết nối cơ sở dữ liệu log
# LOG_SQL_DSN=user:password@tcp(127.0.0.1:3306)/logdb?parseTime=true
# Đường dẫn cơ sở dữ liệu SQLite
# SQLITE_PATH=/path/to/sqlite.db
# Số kết nối nhàn rỗi tối đa của cơ sở dữ liệu
# SQL_MAX_IDLE_CONNS=100
# Số kết nối mở tối đa của cơ sở dữ liệu
# SQL_MAX_OPEN_CONNS=1000
# Vòng đời tối đa của kết nối cơ sở dữ liệu (giây)
# SQL_MAX_LIFETIME=60


# Cấu hình bộ nhớ đệm
# Chuỗi kết nối Redis
# REDIS_CONN_STRING=redis://user:password@localhost:6379/0
# Tần suất đồng bộ (đơn vị: giây)
# SYNC_FREQUENCY=60
# Bật bộ nhớ đệm trong RAM
# MEMORY_CACHE_ENABLED=true
# Tần suất cập nhật kênh (đơn vị: giây)
# CHANNEL_UPDATE_FREQUENCY=30
# Bật cập nhật hàng loạt
# BATCH_UPDATE_ENABLED=true
# Khoảng cách cập nhật hàng loạt (đơn vị: giây)
# BATCH_UPDATE_INTERVAL=5

# Cấu hình tác vụ và chức năng
# Bật tác vụ cập nhật
# UPDATE_TASK=true


# Khóa phiên
# SESSION_SECRET=random_string

# Cấu hình khác
# Tần suất kiểm tra kênh (đơn vị: giây)
# CHANNEL_TEST_FREQUENCY=10
# Tạo token mặc định
# GENERATE_DEFAULT_TOKEN=false
# Cài đặt an toàn Cohere
# COHERE_SAFETY_SETTING=NONE
# Có thống kê token hình ảnh hay không
# GET_MEDIA_TOKEN=true
# Có thống kê token hình ảnh khi không streaming (stream=false) hay không
# GET_MEDIA_TOKEN_NOT_STREAM=true
# Đặt việc kênh Dify có xuất thông tin workflow và node ra client hay không
# DIFY_DEBUG=true
# Đặt thời gian chờ cho một phản hồi streaming
# STREAMING_TIMEOUT=90


# Loại node
# Nếu là node chính thì là master
# NODE_TYPE=master
