# File path: /etc/systemd/system/rexi-hub-v2.service
# sudo systemctl daemon-reload
# sudo systemctl start rexi-hub-v2
# sudo systemctl enable rexi-hub-v2
# sudo systemctl status rexi-hub-v2
[Unit]
Description=One API Service
After=network.target

[Service]
User=ubuntu  # Chú ý sửa tên người dùng
WorkingDirectory=/path/to/rexi-hub-v2  # Chú ý sửa đường dẫn
ExecStart=/path/to/rexi-hub-v2/rexi-hub-v2 --port 3000 --log-dir /path/to/rexi-hub-v2/logs  # Chú ý sửa đường dẫn và số cổng
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
